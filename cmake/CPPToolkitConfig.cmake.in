@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

if(@CPPTOOLKIT_BUILD_UI@)
    find_dependency(imgui CONFIG)
    find_dependency(implot CONFIG)
    find_dependency(raylib CONFIG)
    find_dependency(glfw3 CONFIG)
endif()
if(@CPPTOOLKIT_BUILD_BLE@)
    find_dependency(simpleble CONFIG)
endif()
if(@CPPTOOLKIT_BUILD_MVVM@)
    find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cpptoolkitTargets.cmake")

check_required_components(cpptoolkit)
