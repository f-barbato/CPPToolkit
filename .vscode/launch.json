{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug TestUI (vcpkg + gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/dist/Debug/Windows/AMD64/bin/cpptoolkit_ui_demo.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/dist/Debug/Windows/AMD64/bin",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:\\TDM-GCC-64\\bin;${env:PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\TDM-GCC-64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build debug"
        },
        {
            "type": "cmake",
            "request": "launch",
            "name": "Debug portfile(s)",
            "cmakeDebugType": "external",
            "pipeName": "\\\\.\\pipe\\vcpkg_ext_portfile_dbg",
            "preLaunchTask": "Debug vcpkg commands"
        }
    ]
}
