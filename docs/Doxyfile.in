PROJECT_NAME           = CPPToolkit
PROJECT_NUMBER         = @PROJECT_VERSION@
PROJECT_BRIEF          = "Modular C++ toolkit with MVVM-bound retained UI widgets"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/docs"
INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/docs/mainpage.dox" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/modules/platform/include" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/modules/struct/include" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/modules/mvvm/include" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/modules/algo/include" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/modules/net/include" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/modules/ui/include"
FILE_PATTERNS          = *.h *.dox
RECURSIVE              = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"
OPTIMIZE_OUTPUT_FOR_C  = NO
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS
WARN_LOGFILE           = "@CMAKE_CURRENT_BINARY_DIR@/docs/doxygen-warnings.log"
