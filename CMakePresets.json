{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 23, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (vcpkg toolchain)",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_C_STANDARD": "23",
        "VCPKG_MANIFEST_MODE": "ON"
      }
    },
    {
      "name": "core-only",
      "displayName": "Core modules (platform, struct, mvvm, algo) — no external dependencies",
      "inherits": "default",
      "cacheVariables": {
        "CPPTOOLKIT_BUILD_PLATFORM": "ON",
        "CPPTOOLKIT_BUILD_STRUCT": "ON",
        "CPPTOOLKIT_BUILD_MVVM": "ON",
        "CPPTOOLKIT_BUILD_ALGO": "ON"
      }
    },
    {
      "name": "all-modules",
      "displayName": "All modules, tests and examples",
      "inherits": "default",
      "cacheVariables": {
        "CPPTOOLKIT_BUILD_PLATFORM": "ON",
        "CPPTOOLKIT_BUILD_STRUCT": "ON",
        "CPPTOOLKIT_BUILD_MVVM": "ON",
        "CPPTOOLKIT_BUILD_ALGO": "ON",
        "CPPTOOLKIT_BUILD_UI": "ON",
        "CPPTOOLKIT_BUILD_NET": "ON",
        "CPPTOOLKIT_BUILD_TESTS": "ON",
        "CPPTOOLKIT_BUILD_EXAMPLES": "ON",
        "VCPKG_MANIFEST_FEATURES": "ui;net;tests;examples"
      }
    },
    {
      "name": "all-modules-debug",
      "displayName": "All modules, tests and examples (Debug build)",
      "inherits": "all-modules",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "all-modules-release",
      "displayName": "All modules, tests and examples (Release build)",
      "inherits": "all-modules",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "all-modules-shared-linux",
      "displayName": "Shared modules (Linux, dynamic dependencies)",
      "inherits": "all-modules-release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
      }
    },
    {
      "name": "all-modules-shared-windows",
      "displayName": "Shared modules (Windows x64)",
      "inherits": "all-modules-release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "BUILD_SHARED_LIBS": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "core-only", "configurePreset": "core-only" },
    { "name": "all-modules", "configurePreset": "all-modules" },
    { "name": "all-modules-debug", "configurePreset": "all-modules-debug" },
    { "name": "all-modules-release", "configurePreset": "all-modules-release" },
    { "name": "all-modules-shared-linux", "configurePreset": "all-modules-shared-linux" },
    { "name": "all-modules-shared-windows", "configurePreset": "all-modules-shared-windows" }
  ]
}
